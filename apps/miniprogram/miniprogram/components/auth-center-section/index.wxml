<!-- components/auth-center-section/index.wxml -->
<view class="auth-section">
  <view class="section-title">🎯 设备授权中心</view>
  <view class="auth-card" wx:for="{{brands}}" wx:key="key" wx:for-item="brand">
    <view class="auth-card-icon" style="background: {{brand.color}};">{{brand.icon}}</view>
    <view class="auth-card-info">
      <view class="auth-card-name">{{brand.name}}</view>
      <view class="auth-card-status">
        <text class="status-tag {{brand.bound ? 'bound' : 'unbound'}}">
          {{brand.bound ? '✓ 已绑定' : (brand.configured ? '○ 未绑定' : '✗ 未配置')}}
        </text>
        <text class="status-time" wx:if="{{brand.lastSyncAt}}">{{brand.lastSyncAt}}</text>
      </view>
      <view class="auth-card-meta" wx:if="{{brand.bound && brand.recentCount > 0}}">最近 {{brand.recentCount}} 条活动</view>
    </view>
    <view class="auth-card-actions">
      <view class="auth-btn auth-btn-primary" data-brand-key="{{brand.key}}" bindtap="onTapAuth">
        {{brand.bound ? '重新授权' : '授权'}}
      </view>
      <view class="auth-btn auth-btn-ghost" data-vendor="{{brand.vendorOAuthKey}}" wx:if="{{brand.bound}}" bindtap="onTapUnbind">解绑</view>
    </view>
    <view class="auth-card-detail" data-brand-key="{{brand.key}}" bindtap="onTapDetail">查看详情 ›</view>
  </view>
</view>