/* components/auth-center-section/index.wxss */
.auth-section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.section-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; }
.auth-card { display: flex; align-items: center; padding: 20rpx; margin-bottom: 16rpx; background: #fafafa; border-radius: 12rpx; position: relative; }
.auth-card:last-child { margin-bottom: 0; }
.auth-card-icon { width: 80rpx; height: 80rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: #fff; margin-right: 20rpx; flex-shrink: 0; }
.auth-card-info { flex: 1; min-width: 0; }
.auth-card-name { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 6rpx; }
.auth-card-status { display: flex; align-items: center; gap: 12rpx; margin-bottom: 6rpx; }
.status-tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; font-weight: 600; }
.status-tag.bound { background: #d4f4dd; color: #2D9D78; }
.status-tag.unbound { background: #fff3d6; color: #e67e22; }
.status-time { font-size: 22rpx; color: #888; }
.auth-card-meta { font-size: 22rpx; color: #888; }
.auth-card-actions { display: flex; flex-direction: column; gap: 8rpx; margin-left: 12rpx; flex-shrink: 0; }
.auth-btn { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 24rpx; text-align: center; min-width: 100rpx; }
.auth-btn-primary { background: #2D9D78; color: #fff; }
.auth-btn-ghost { background: transparent; color: #888; border: 1rpx solid #ccc; }
.auth-card-detail { position: absolute; bottom: 12rpx; right: 24rpx; font-size: 22rpx; color: #2D9D78; }