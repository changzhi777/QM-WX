<view class="container">
  <!-- V0.2.146 分享 FAB（trigger 微信原生 onShareAppMessage） -->
  <button class="share-fab" open-type="share">↗</button>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!session}}" class="empty">记录不存在或已删除</view>
  <block wx:else>
    <!-- 头部概览 -->
    <view class="hero">
      <view class="hero__date">{{session.dateStr}}</view>
      <view class="hero__stats">
        <view class="hero__stat">
          <view class="hero__stat-num">{{sets.length}}</view>
          <view class="hero__stat-label">组数</view>
        </view>
        <view class="hero__stat">
          <view class="hero__stat-num">{{session.totalVolumeText}}</view>
          <view class="hero__stat-label">总容量</view>
        </view>
        <view class="hero__stat">
          <view class="hero__stat-num">{{session.durationText}}</view>
          <view class="hero__stat-label">时长</view>
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view wx:if="{{session.notes}}" class="notes-card">
      <view class="notes-card__label">备注</view>
      <view class="notes-card__text">{{session.notes}}</view>
    </view>

    <!-- V0.2.126 个人最佳 PB（按动作） -->
    <view wx:if="{{pbs.length > 0}}" class="section-title">🏆 个人最佳</view>
    <view wx:if="{{pbs.length > 0}}" class="pb-list">
      <view wx:for="{{pbs}}" wx:key="exerciseName" class="pb-item">
        <view class="pb-item__name">{{item.exerciseName}}</view>
        <view class="pb-item__weight">{{item.maxWeight}}<text class="pb-item__unit">kg</text></view>
        <view class="pb-item__reps">× {{item.maxReps}} 次 · {{item.setCount}} 组</view>
      </view>
    </view>

    <!-- V0.2.126 容量分布 -->
    <view wx:if="{{distribution.length > 0}}" class="section-title">📊 容量分布</view>
    <view wx:if="{{distribution.length > 0}}" class="dist-list">
      <view wx:for="{{distribution}}" wx:key="exerciseName" class="dist-item">
        <view class="dist-item__row">
          <view class="dist-item__name">{{item.exerciseName}}</view>
          <view class="dist-item__vol">{{item.totalVolumeText}}</view>
          <view class="dist-item__pct">{{item.percent}}%</view>
        </view>
        <view class="dist-item__bar">
          <view class="dist-item__fill" style="width: {{item.percent}}%;"></view>
        </view>
      </view>
    </view>

    <!-- 按动作分组的组列表 -->
    <view class="section-title">动作明细</view>
    <view class="group-list">
      <view wx:for="{{groupedSets}}" wx:key="exerciseName" wx:for-item="grp" class="group">
        <view class="group__name" data-name="{{grp.exerciseName}}" bindtap="onTapExerciseTrend">
          {{grp.exerciseName}}
          <text class="group__count">{{grp.sets.length}} 组</text>
          <text class="group__trend">📈 趋势</text>
        </view>
        <view class="group__list">
          <view wx:for="{{grp.sets}}" wx:for-item="s" wx:key="order" class="set-row">
            <view class="set-row__idx">#{{s.setIndex}}</view>
            <view class="set-row__detail">{{s.reps}} 次 × {{s.weight}} kg</view>
            <view class="set-row__vol">{{s.reps * s.weight}} kg·次</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- V0.2.135 动作趋势 modal（点动作名打开） -->
  <view class="trend-modal" wx:if="{{trendVisible}}" bindtap="onCloseTrendModal">
    <view class="trend-modal__panel" catchtap="">
      <view class="trend-modal__title">{{trend.exerciseName || ''}} · 90 天趋势</view>
      <view wx:if="{{trend.loading}}" class="trend-modal__hint">加载中…</view>
      <block wx:elif="{{trend.points.length === 0}}">
        <view class="trend-modal__hint">暂无训练记录</view>
      </block>
      <block wx:else>
        <!-- V0.2.135 简易 SVG 折线图：maxWeight 随时间 -->
        <view class="trend-svg-wrap">
          <svg viewBox="0 0 {{trend.svg.w}} {{trend.svg.h}}" class="trend-svg">
            <!-- 网格线 -->
            <line x1="40" y1="20" x2="40" y2="{{trend.svg.h - 30}}" stroke="#eee" stroke-width="1" />
            <line x1="40" y1="{{trend.svg.h - 30}}" x2="{{trend.svg.w - 20}}" y2="{{trend.svg.h - 30}}" stroke="#eee" stroke-width="1" />
            <!-- Y 轴 labels（min/max） -->
            <text x="4" y="24" font-size="20" fill="#999">{{trend.svg.maxW}}</text>
            <text x="4" y="{{trend.svg.h - 30}}" font-size="20" fill="#999">{{trend.svg.minW}}</text>
            <!-- X 轴 labels（首/末日期） -->
            <text x="40" y="{{trend.svg.h - 10}}" font-size="18" fill="#999">{{trend.svg.firstDate}}</text>
            <text x="{{trend.svg.w - 100}}" y="{{trend.svg.h - 10}}" font-size="18" fill="#999">{{trend.svg.lastDate}}</text>
            <!-- 折线 path -->
            <polyline points="{{trend.svg.points}}" stroke="#2D9D78" stroke-width="3" fill="none" />
            <!-- 圆点 -->
            <circle wx:for="{{trend.svg.dots}}" wx:key="i" wx:for-item="dot" cx="{{dot.x}}" cy="{{dot.y}}" r="4" fill="#2D9D78" />
          </svg>
        </view>
        <view class="trend-modal__stats">
          共 {{trend.totalSessions}} 次训练 · 最高 {{trend.maxWeightAllTime}} kg
        </view>
      </block>
      <view class="trend-modal__close" bindtap="onCloseTrendModal">关闭</view>
    </view>
  </view>

  <!-- V0.2.144 训练报告 modal（metrics + 动作分布 + RPE 完成度） -->
  <view class="report-modal" wx:if="{{reportVisible}}" bindtap="onCloseReport">
    <view class="report-modal__panel" catchtap="">
      <view class="report-modal__title">📊 训练报告 · {{report.data.dateStr || ''}}</view>
      <view wx:if="{{report.loading}}" class="report-modal__hint">加载中…</view>
      <block wx:elif="{{report.data}}">
        <view class="report-modal__metrics">
          <view class="report-metric">
            <text class="report-metric__num">{{report.data.totalSets}}</text>
            <text class="report-metric__label">组数</text>
          </view>
          <view class="report-metric">
            <text class="report-metric__num">{{report.data.totalReps}}</text>
            <text class="report-metric__label">次数</text>
          </view>
          <view class="report-metric">
            <text class="report-metric__num">{{report.data.totalVolume}}</text>
            <text class="report-metric__label">kg·次</text>
          </view>
          <view class="report-metric">
            <text class="report-metric__num">{{report.data.avgRpe || '—'}}</text>
            <text class="report-metric__label">平均 RPE</text>
          </view>
        </view>
        <view class="report-modal__row">RPE 填写率 {{report.data.rpeCompletion}}% · 时长 {{report.data.durationText}}</view>
        <view class="report-section">动作明细</view>
        <view class="report-exercise" wx:for="{{report.data.exercises}}" wx:key="exerciseName" wx:for-item="ex">
          <view class="report-exercise__head">
            <text class="report-exercise__name">{{ex.exerciseName}}</text>
            <text class="report-exercise__vol">{{ex.volume}} kg·次</text>
          </view>
          <view class="report-exercise__meta">{{ex.sets}} 组 · max {{ex.maxWeight}}kg × {{ex.reps}} 次<text wx:if="{{ex.avgRpe}}"> · RPE {{ex.avgRpe}}</text></view>
        </view>
        <view wx:if="{{report.data.notes}}" class="report-notes">📝 {{report.data.notes}}</view>

        <!-- V0.2.149 完成度评分（4 因子加权 + 高 RPE 加分） -->
        <view wx:if="{{completion}}" class="completion-section">
          <view class="completion-section__title">⭐ 完成度评分</view>
          <view class="completion-score" style="background: {{completion.score >= 90 ? 'linear-gradient(135deg, #FFD54F, #FFA726)' : completion.score >= 60 ? 'linear-gradient(135deg, #2D9D78, #4FB68F)' : 'linear-gradient(135deg, #90A4AE, #607D8B)'}}">
            <text class="completion-score__num">{{completion.score}}</text>
            <text class="completion-score__label">分</text>
          </view>
          <view class="completion-factors">
            <view class="completion-factor">
              <text class="completion-factor__label">💪 RPE 填写率</text>
              <view class="completion-factor__bar">
                <view class="completion-factor__fill" style="width: {{completion.factors.rpeCoverage}}%;"></view>
              </view>
              <text class="completion-factor__pct">{{completion.factors.rpeCoverage}}%</text>
            </view>
            <view class="completion-factor">
              <text class="completion-factor__label">❤️ 组间心率</text>
              <view class="completion-factor__bar">
                <view class="completion-factor__fill" style="width: {{completion.factors.postHrCoverage}}%;"></view>
              </view>
              <text class="completion-factor__pct">{{completion.factors.postHrCoverage}}%</text>
            </view>
            <view class="completion-factor">
              <text class="completion-factor__label">📝 备注填写率</text>
              <view class="completion-factor__bar">
                <view class="completion-factor__fill" style="width: {{completion.factors.noteCoverage}}%;"></view>
              </view>
              <text class="completion-factor__pct">{{completion.factors.noteCoverage}}%</text>
            </view>
            <view class="completion-factor">
              <text class="completion-factor__label">🎯 动作多样性</text>
              <view class="completion-factor__bar">
                <view class="completion-factor__fill" style="width: {{completion.factors.exerciseDiversity}}%;"></view>
              </view>
              <text class="completion-factor__pct">{{completion.factors.exerciseDiversity}}%</text>
            </view>
          </view>
          <view wx:if="{{completion.bonus > 0}}" class="completion-bonus">🏅 高质量记录 +{{completion.bonus}}（平均 RPE {{completion.avgRpe}}）</view>
        </view>
      </block>
      <view class="report-modal__actions">
        <view class="report-modal__share" bindtap="onSavePoster">🎨 保存海报</view>
        <view class="report-modal__share report-modal__share--secondary" bindtap="onShareReport">📋 复制摘要</view>
        <view class="report-modal__close" bindtap="onCloseReport">关闭</view>
      </view>
    </view>
  </view>
  <!-- V0.2.145 Canvas 海报节点（375×667 = 750×1334 的 0.5 倍渲染，自动高清） -->
  <canvas canvas-id="training-poster" class="poster-canvas"></canvas>
</view>
