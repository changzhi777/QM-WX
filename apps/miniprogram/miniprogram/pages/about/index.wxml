<view class="page">
  <!-- 顶部品牌 -->
  <view class="brand-section">
    <view class="brand-logo">🌿</view>
    <view class="brand-name">{{brandName}}</view>
    <view class="brand-version">{{version}}</view>
    <view class="brand-desc">{{desc}}</view>
  </view>

  <!-- 核心功能 -->
  <view class="section">
    <view class="section-title">核心功能</view>
    <view class="feature-card" wx:for="{{features}}" wx:key="title">
      <view class="feature-icon">{{item.icon}}</view>
      <view class="feature-body">
        <view class="feature-title">{{item.title}}</view>
        <view class="feature-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 公司信息 -->
  <view class="section">
    <view class="section-title">关于我们</view>
    <view class="info-card" bindtap="onTapCopy">
      <view class="info-label">公司</view>
      <view class="info-value">{{company}}</view>
    </view>
    <view class="info-card" bindtap="onTapAgreement">
      <view class="info-label">协议</view>
      <view class="info-value">用户服务协议 / 隐私政策 ›</view>
    </view>
  </view>

  <view class="footer">© 2026 湖南青沐生命科技有限公司</view>
</view>
