/* pages/about/index.wxss — 关于沐禾健康 */
.page { padding: 32rpx; min-height: 100vh; background: #f5f6f8; }
.brand-section { text-align: center; padding: 48rpx 32rpx; }
.brand-logo { font-size: 96rpx; }
.brand-name { font-size: 40rpx; font-weight: 700; color: #2D9D78; margin-top: 16rpx; }
.brand-version { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.brand-desc { font-size: 26rpx; color: #666; margin-top: 16rpx; line-height: 1.5; }
.section { margin-top: 32rpx; }
.section-title { font-size: 28rpx; color: #888; margin-bottom: 16rpx; padding-left: 8rpx; }
.feature-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 12rpx; display: flex; align-items: center; }
.feature-icon { font-size: 40rpx; margin-right: 20rpx; }
.feature-body { flex: 1; }
.feature-title { font-size: 30rpx; font-weight: 600; color: #333; }
.feature-desc { font-size: 24rpx; color: #888; margin-top: 4rpx; }
.info-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 12rpx; display: flex; justify-content: space-between; align-items: center; }
.info-label { font-size: 28rpx; color: #666; }
.info-value { font-size: 26rpx; color: #333; text-align: right; }
.footer { text-align: center; font-size: 22rpx; color: #bbb; margin-top: 64rpx; }
