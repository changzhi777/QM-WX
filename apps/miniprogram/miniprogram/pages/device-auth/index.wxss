/* pages/device-auth/index.wxss
/* Hallmark · macrostructure: Letter · genre: Editorial · theme: Lumen
 * redesign: 信头 + 散文 + 2-col activities + 底部 Sign-off
 * preserves: web-view 授权跳转 + 5 条活动预览 + auth 按钮
 */
.page { min-height: 100vh; background: #faf8f3; padding: 48rpx 40rpx 80rpx; max-width: 720rpx; margin: 0 auto; font-family: Georgia, serif; }

/* === 信头（letter 信纸抬头） === */
.letter-header { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1rpx solid #1a1a1a; padding-bottom: 16rpx; margin-bottom: 48rpx; }
.letter-wordmark { font-size: 32rpx; font-weight: 700; color: #1a1a1a; letter-spacing: 0.02em; }
.letter-date { font-size: 22rpx; color: #666; font-style: italic; }

/* === 致用户 + 散文 body（信纸风） === */
.letter-salutation { font-size: 30rpx; color: #1a1a1a; margin-bottom: 24rpx; font-weight: 400; }
.letter-body { margin-bottom: 48rpx; }
.letter-line { font-size: 26rpx; color: #1a1a1a; line-height: 1.7; margin-bottom: 16rpx; }
.letter-paragraph { font-size: 26rpx; color: #333; line-height: 1.8; margin-bottom: 16rpx; text-indent: 2em; }
.brand-mention { font-weight: 600; color: #1a1a1a; }
.time { font-weight: 600; color: #1a1a1a; border-bottom: 1rpx dotted #1a1a1a; }

/* === 授权 CTA（letter 行动号召） === */
.letter-cta { margin-bottom: 56rpx; }
.auth-btn-primary { display: inline-block; font-size: 28rpx; padding: 14rpx 32rpx; background: #1a1a1a; color: #faf8f3; border-radius: 0; font-weight: 600; }

/* === 最近活动（2-col + 首条大） === */
.letter-section { margin-bottom: 48rpx; }
.letter-section-head { font-size: 24rpx; color: #1a1a1a; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 16rpx; padding-bottom: 8rpx; border-bottom: 1rpx solid #d4a017; }
.letter-activities { display: flex; flex-direction: column; gap: 8rpx; }
.letter-act-row { display: flex; align-items: baseline; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx dotted #ececec; }
.letter-act-row.first { padding: 20rpx 0; border-bottom: 1rpx solid #1a1a1a; }
.letter-act-row.first .letter-act-type { font-size: 32rpx; }
.letter-act-row.first .letter-act-distance { font-size: 28rpx; }
.letter-act-type { font-size: 26rpx; color: #1a1a1a; font-weight: 400; }
.letter-act-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.letter-act-distance { font-size: 24rpx; color: #1a1a1a; font-weight: 700; font-variant-numeric: tabular-nums; }
.letter-act-time { font-size: 20rpx; color: #888; font-style: italic; }

.empty-line { font-size: 24rpx; color: #888; font-style: italic; padding: 16rpx 0; }

/* === Sign-off（letter 结尾） === */
.letter-signoff { padding-top: 32rpx; border-top: 1rpx solid #1a1a1a; text-align: right; }
.signoff-line { font-size: 22rpx; color: #666; font-style: italic; }

/* === web-view 授权跳转（保留全屏 mask + bottom bar 改文字） === */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 100; display: flex; align-items: center; justify-content: center; }
.webview-wrap { width: 90%; height: 80%; background: #faf8f3; position: relative; }
.webview-bottombar { position: absolute; bottom: 0; left: 0; right: 0; padding: 24rpx; background: rgba(250,248,243,0.96); border-top: 1rpx solid #1a1a1a; color: #1a1a1a; font-size: 26rpx; text-align: center; letter-spacing: 0.05em; font-family: Georgia, serif; }