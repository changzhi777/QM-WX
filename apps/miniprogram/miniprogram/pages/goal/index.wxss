/* pages/goal/index.wxss
/* Hallmark · macrostructure: Stat-Led · genre: Editorial · theme: Newsprint
 * redesign: hero stat 段 + priority-driven card size + 5-segment progress + diff CTA
 * preserves: 6 kind goals + add/update sheet + FAB + emoji-to-text
 */
.page { padding: 16rpx; min-height: 100vh; background: #f5f6f8; }
.goal-list { padding-bottom: 140rpx; }

/* === V0.3.24 hallmark hero stat 段（替换 emoji title） === */
.rec-section { background: #fff; border-radius: 4rpx 4rpx 0 0; padding: 32rpx 24rpx 16rpx; margin-bottom: 16rpx; border-bottom: 2rpx solid #1a1a1a; }
.rec-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24rpx; }
.rec-stat-row { display: flex; align-items: baseline; gap: 12rpx; }
.rec-stat-num { font-size: 64rpx; font-weight: 800; line-height: 1; color: #1a1a1a; font-family: Georgia, serif; }
.rec-stat-label { font-size: 22rpx; color: #666; letter-spacing: 0.05em; }
.rec-close { font-size: 22rpx; color: #888; padding: 4rpx 12rpx; border: 1rpx solid #ddd; border-radius: 4rpx; }

/* === V0.3.24 hallmark: 3 种 size by priority === */
.rec-card { background: #fff; border-radius: 0; padding: 24rpx; margin-bottom: 2rpx; position: relative; border-left: 4rpx solid transparent; }
/* priority 10+: 大卡（占满宽 + 双行布局 + 边框） */
.rec-card-prio-high { padding: 36rpx 32rpx; border-left-color: #1a1a1a; background: #faf8f3; }
/* priority 6-8: 中卡（标准 padding） */
.rec-card-prio-mid { padding: 28rpx 24rpx; border-left-color: #d4a017; }
/* priority <6: 紧凑（最小 padding） */
.rec-card-prio-low { padding: 20rpx 16rpx; border-left-color: #ccc; }

.rec-priority-tag { display: inline-block; font-size: 20rpx; font-weight: 700; padding: 4rpx 10rpx; border-radius: 2rpx; margin-bottom: 12rpx; letter-spacing: 0.05em; }
.rec-card-prio-high .rec-priority-tag { background: #1a1a1a; color: #faf8f3; }
.rec-card-prio-mid .rec-priority-tag { background: #d4a017; color: #fff; }
.rec-card-prio-low .rec-priority-tag { background: #f0f0f0; color: #666; }

.rec-card-title { font-size: 30rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 8rpx; line-height: 1.3; }
.rec-card-prio-high .rec-card-title { font-size: 36rpx; font-family: Georgia, serif; }
.rec-card-prio-low .rec-card-title { font-size: 26rpx; }
.rec-reason { font-size: 24rpx; color: #555; line-height: 1.5; margin-bottom: 12rpx; }
.rec-card-prio-low .rec-reason { font-size: 22rpx; }
.rec-target { font-size: 26rpx; color: #1a1a1a; font-weight: 600; margin-bottom: 16rpx; }

/* === diff CTA by priority（高优先级实色 + 边框；低优先级文字链） === */
.rec-actions { display: flex; justify-content: flex-end; }
.rec-btn { font-size: 24rpx; padding: 12rpx 28rpx; border-radius: 4rpx; text-align: center; min-width: 120rpx; font-weight: 600; }
.rec-btn-high { background: #1a1a1a; color: #faf8f3; border: 2rpx solid #1a1a1a; }
.rec-btn-mid { background: #2D9D78; color: #fff; border: 2rpx solid #2D9D78; }
.rec-btn-low { background: transparent; color: #2D9D78; border: none; padding: 12rpx 0; text-decoration: underline; min-width: auto; }

/* === 目标列表 + 5-segment progress block === */
.goal-card { background: #fff; border-radius: 4rpx; padding: 24rpx; margin-bottom: 12rpx; box-shadow: 0 1rpx 0 rgba(0,0,0,0.06); }
.goal-head { display: flex; align-items: center; }
.goal-icon { font-size: 36rpx; margin-right: 12rpx; }
.goal-title { font-size: 30rpx; font-weight: 600; flex: 1; color: #333; }
.goal-status-row { display: flex; gap: 8rpx; }
.goal-status { font-size: 22rpx; padding: 2rpx 10rpx; border-radius: 2rpx; font-weight: 600; }
.goal-status.completed { background: #2D9D78; color: #fff; }
.goal-status.expired { background: #d4a017; color: #fff; }

.goal-progress { margin-top: 16rpx; }
.seg-row { display: flex; gap: 6rpx; margin-bottom: 12rpx; }
.seg { flex: 1; height: 16rpx; background: #ececec; border-radius: 0; transition: background 0.2s; }
.seg.filled { background: #2D9D78; }
.goal-numbers { font-size: 22rpx; color: #666; }
.goal-numbers .num { font-weight: 600; color: #1a1a1a; font-variant-numeric: tabular-nums; }

.goal-friendly { margin-top: 12rpx; padding: 12rpx 16rpx; background: #fef9e7; border-left: 3rpx solid #d4a017; }
.goal-friendly-tip { font-size: 22rpx; color: #8a6d3b; line-height: 1.5; }
.goal-actions { margin-top: 16rpx; display: flex; justify-content: flex-end; gap: 12rpx; }
.goal-btn { font-size: 24rpx; color: #555; padding: 8rpx 20rpx; border: 1rpx solid #ccc; border-radius: 4rpx; background: #fff; }

.empty { text-align: center; padding: 120rpx 32rpx; }
.empty-icon { font-size: 60rpx; display: block; color: #999; margin-bottom: 16rpx; }
.empty-text { display: block; margin-top: 16rpx; font-size: 28rpx; color: #333; font-weight: 600; }
.empty-sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: #888; }
.fab { position: fixed; right: 32rpx; bottom: 60rpx; width: 88rpx; height: 88rpx; background: #1a1a1a; color: #faf8f3; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 48rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15); }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: flex-end; z-index: 100; }
.sheet { background: #fff; border-radius: 0; padding: 32rpx; width: 100%; border-top: 2rpx solid #1a1a1a; }
.sheet-title { font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; color: #1a1a1a; font-family: Georgia, serif; }
.sheet-row { margin-bottom: 24rpx; }
.sheet-label { display: block; font-size: 22rpx; color: #888; margin-bottom: 8rpx; text-transform: uppercase; letter-spacing: 0.05em; }
.sheet-input { border: 1rpx solid #1a1a1a; border-radius: 0; padding: 16rpx; font-size: 28rpx; font-variant-numeric: tabular-nums; }
.picker { padding: 16rpx; border: 1rpx solid #1a1a1a; border-radius: 0; color: #333; font-size: 28rpx; }
.sheet-btn { background: #1a1a1a; color: #faf8f3; border-radius: 0; margin-top: 32rpx; font-size: 30rpx; font-weight: 600; }